# Required for DB-backed API routes and role redirects
DATABASE_URL=postgresql://postgres:password@localhost:5432/mealsaver

# Clerk (dev keys shown here are placeholders)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional integrations used by specific features/routes
CRON_SECRET=change-me
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+10000000000
